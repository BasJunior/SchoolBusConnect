# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database

# Environment
NODE_ENV=production

# Session Configuration (generate a secure random string)
SESSION_SECRET=your-super-secret-session-key-here

# Optional: If you're using any API keys
# MAPS_API_KEY=your-maps-api-key
# PAYMENT_API_KEY=your-payment-api-key

# BVSBus Stripe sandbox (test mode only)
# The server explicitly rejects sk_live_/rk_live_ keys.
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret

# Public origin used in Stripe Checkout and Connect return URLs.
# Example: https://your-bvsbus-app.example.com
PUBLIC_APP_URL=http://localhost:3001
